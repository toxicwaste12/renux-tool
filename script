def website_scan():


    clear_screen()

    show_startup()



    url = input(

        Colors.YELLOW +

        "Target URL: " +

        Colors.RESET

    )



    url = normalize_url(url)



    print(

        "\nScanning:",

        url

    )



    start = time.time()



    response = send_request(url)



    if response is None:


        pause()

        return




    print(

        Colors.GREEN +

        "\nConnection successful" +

        Colors.RESET

    )




    basic = get_basic_info(

        url,

        response

    )



    waf = analyze_waf(

        response

    )



    headers = analyze_security_headers(

        response

    )



    tls = analyze_tls(

        url

    )



    dns = analyze_dns(

        url

    )



    cookies = analyze_cookies(

        response

    )



    technology = analyze_technology(

        response

    )



    cdn = analyze_cdn(

        response

    )



    report = create_report(

        url,

        basic,

        waf,

        headers,

        tls,

        dns,

        cookies,

        technology

    )



    report["cdn"] = cdn



    elapsed = round(

        time.time()

        -

        start,

        2

    )



    report["scan_time"] = (

        str(elapsed)

        +

        " seconds"

    )



    SCAN_HISTORY.append(

        report

    )



    display_waf(

        waf

    )



    display_security_headers(

        headers

    )



    display_tls(

        tls

    )



    display_dns(

        dns

    )



    display_cookies(

        cookies

    )



    display_final_report(

        report

    )



    pause()





