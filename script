# ============================================================
# DNS INTELLIGENCE
# ============================================================


def analyze_dns(url):


    domain = get_domain(url)



    result = {


        "domain":

        domain,


        "ipv4":

        [],


        "ipv6":

        []

    }




    try:


        records = socket.getaddrinfo(

            domain,

            None

        )



        for item in records:



            ip = item[4][0]



            if ":" in ip:


                if ip not in result["ipv6"]:


                    result["ipv6"].append(

                        ip

                    )


            else:


                if ip not in result["ipv4"]:


                    result["ipv4"].append(

                        ip

                    )



    except Exception:


        pass



    return result






