    result = {


        "count":

        len(cookies),


        "secure":

        [],


        "missing_security":

        [],


        "score":

        100

    }




    for cookie in cookies:


        name = cookie.name



        secure = cookie.secure



        httponly = (

            "httponly"

            in

            str(cookie)

            .lower()

        )



        if secure:


            result["secure"].append(

                name

            )


        else:


            result["missing_security"].append(

                name

            )



        if not secure or not httponly:


            result["score"] -= 10




    if result["score"] < 0:


        result["score"] = 0



    return result





