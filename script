# ============================================================
# TECHNOLOGY DETECTION
# ============================================================


def analyze_technology(response):


    technologies = []



    headers = response.headers



    server = headers.get(

        "Server",

        ""

    ).lower()



    powered = headers.get(

        "X-Powered-By",

        ""

    ).lower()



    body = response.text.lower()



    fingerprints = {


        "Apache":

        [

            "apache"

        ],


        "Nginx":

        [

            "nginx"

        ],


        "PHP":

        [

            "php",

            "x-powered-by: php"

        ],


        "ASP.NET":

        [

            "asp.net",

            "x-powered-by: asp.net"

        ],


        "WordPress":

        [

            "wp-content",

            "wordpress"

        ],


        "Laravel":

        [

            "laravel"

        ]

    }




    data = (

        server

        +

        powered

        +

        body

    )



    for tech, signs in fingerprints.items():


        for sign in signs:


            if sign in data:


                technologies.append(

                    tech

                )


                break



    return list(

        set(

            technologies

        )

    )





# ============================================================
# WAF INTELLIGENCE
# ============================================================


def analyze_waf(response):


    results = []



    headers = {

        k.lower():

        v.lower()

        for k,v in response.headers.items()

    }



    combined = (

        str(headers)

        +

        response.text.lower()

    )



    for name, data in WAF_SIGNATURES.items():


        evidence = []



        for signature in data["headers"]:



            if (

                signature.lower()

                in

                combined

            ):


                evidence.append(

                    signature

                )



        if evidence:



            confidence = min(

                95,

                40

                +

                (

                    len(evidence)

                    *

                    20

                )

            )



            results.append({


                "name":

                name,


                "vendor":

                data["vendor"],


                "type":

                data["type"],


                "evidence":

                evidence,


                "confidence":

                confidence


            })



    return results





