def analyze_security_headers(response):


    headers = {

        k.lower():

        v

        for k, v in response.headers.items()

    }



    security_headers = {


        "strict-transport-security":

        {

            "name":

            "Strict-Transport-Security",

            "severity":

            "Medium"

        },


        "content-security-policy":

        {

            "name":

            "Content-Security-Policy",

            "severity":

            "Medium"

        },


        "x-frame-options":

        {

            "name":

            "X-Frame-Options",

            "severity":

            "Low"

        },


        "x-content-type-options":

        {

            "name":

            "X-Content-Type-Options",

            "severity":

            "Low"

        },


        "referrer-policy":

        {

            "name":

            "Referrer-Policy",

            "severity":

            "Low"

        },


        "permissions-policy":

        {

            "name":

            "Permissions-Policy",

            "severity":

            "Low"

        }

    }




    enabled = []

    missing = []



    for key, data in security_headers.items():


        if key in headers:


            enabled.append(

                data["name"]

            )


        else:


            missing.append(

                {

                    "name":

                    data["name"],


                    "severity":

                    data["severity"]

                }

            )



    score = int(

        (

            len(enabled)

            /

            len(security_headers)

        )

        *

        100

    )



    return {


        "enabled":

        enabled,


        "missing":

        missing,


        "score":

        score

    }





