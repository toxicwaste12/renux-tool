# ============================================================
# URL NORMALIZER
# ============================================================


def normalize_url(url):


    url = url.strip()



    if not url.startswith(
        "http://"
    ) and not url.startswith(
        "https://"
    ):

        url = "https://" + url



    return url




# ============================================================
# DOMAIN EXTRACTOR
# ============================================================


def get_domain(url):

    parsed = urlparse(url)

    return parsed.netloc




# ============================================================
# HTTP REQUEST ENGINE
# ============================================================


def send_request(url):


    headers = {


        "User-Agent":

        CONFIG["user_agent"]

    }



    try:


        response = requests.get(

            url,

            headers=headers,

            timeout=CONFIG["timeout"],

            allow_redirects=True

        )


        return response



    except requests.exceptions.SSLError:


        print(

            Colors.RED +

            "SSL certificate error" +

            Colors.RESET

        )


        return None



    except requests.exceptions.Timeout:


        print(

            Colors.RED +

            "Connection timeout" +

            Colors.RESET

        )


        return None



    except requests.exceptions.ConnectionError:


        print(

            Colors.RED +

            "Connection failed" +

            Colors.RESET

        )


        return None



    except Exception as e:


        print(

            Colors.RED +

            "Error: "

            +

            str(e)

            +

            Colors.RESET

        )


        return None




