# ============================================================
# CDN DETECTION
# ============================================================


def analyze_cdn(response):


    headers = {

        k.lower():

        v.lower()

        for k, v in response.headers.items()

    }



    text = str(headers)



    cdn_signatures = {


        "Cloudflare":

        [

            "cf-ray",

            "cloudflare"

        ],


        "Akamai":

        [

            "akamai",

            "x-akamai"

        ],


        "Fastly":

        [

            "fastly",

            "x-served-by"

        ],


        "Amazon CloudFront":

        [

            "cloudfront",

            "x-amz-cf-id"

        ]

    }



    detected = []



    for name, signs in cdn_signatures.items():


        for sign in signs:


            if sign in text:


                detected.append(

                    name

                )


                break



    return list(

        set(

            detected

        )

    )





# ============================================================
# SECURITY SCORE ENGINE
# ============================================================


def calculate_security_score(

        waf,

        headers,

        tls,

        cookies

):


    score = 0



    # WAF Protection

    if waf:


        score += 25



    # Security Headers

    score += int(

        headers["score"]

        *

        0.30

    )



    # TLS

    score += int(

        tls["score"]

        *

        0.30

    )



    # Cookies

    score += int(

        cookies["score"]

        *

        0.15

    )



    if score > 100:


        score = 100



    return score





# ============================================================
# GRADE SYSTEM
# ============================================================


def calculate_grade(score):


    if score >= 90:

        return "A"



    elif score >= 75:

        return "B"



    elif score >= 60:

        return "C"



    elif score >= 40:

        return "D"



    else:

        return "F"





# ============================================================
# RISK LEVEL
# ============================================================


def calculate_risk(score):


    if score >= 85:


        return "LOW"



    elif score >= 60:


        return "MEDIUM"



    elif score >= 40:


        return "HIGH"



    else:


        return "CRITICAL"





