def generate_recommendations(

        headers,

        tls,

        cookies,

        waf

):


    recommendations = []



    if not waf:


        recommendations.append(

            "No known WAF detected"

        )



    for item in headers["missing"]:


        recommendations.append(

            "Enable "

            +

            item["name"]

        )



    if tls["score"] < 100:


        recommendations.append(

            "Improve TLS certificate configuration"

        )



    if cookies["score"] < 100:


        recommendations.append(

            "Enable Secure and HttpOnly cookie flags"

        )



    if not recommendations:


        recommendations.append(

            "No major security improvements detected"

        )



    return recommendations# ============================================================
