# ============================================================
# TLS / SSL ANALYZER
# ============================================================


def analyze_tls(url):


    result = {


        "enabled":

        False,


        "version":

        "Unknown",


        "certificate":

        "Unknown",


        "days_remaining":

        None,


        "score":

        0

    }




    try:


        parsed = urlparse(url)



        host = parsed.hostname



        if not host:


            return result



        context = ssl.create_default_context()



        with socket.create_connection(

            (host, 443),

            timeout=10

        ) as sock:



            with context.wrap_socket(

                sock,

                server_hostname=host

            ) as ssock:



                cert = ssock.getpeercert()



                result["enabled"] = True



                result["version"] = (

                    ssock.version()

                )



                result["certificate"] = (

                    cert.get(

                        "notAfter",

                        "Unknown"

                    )

                )



                if cert.get("notAfter"):


                    expire = datetime.datetime.strptime(

                        cert["notAfter"],

                        "%b %d %H:%M:%S %Y %Z"

                    )



                    now = datetime.datetime.utcnow()



                    days = (

                        expire - now

                    ).days



                    result["days_remaining"] = days



                    if days > 30:


                        result["score"] = 100


                    else:


                        result["score"] = 50



    except Exception:


        pass



    return result





